#!name=Figma zh-CN Localized
#!desc=Redirect Figma web app language bundle to zh-CN localized JSON. Keep your MITM CA certificate configured locally in Surge.
#!author=kailous
#!homepage=https://github.com/kailous/SurgeConfig

[URL Rewrite]
https:\/\/www\.figma\.com\/webpack-artifacts\/assets\/figma_app(?:_beta)?-[a-f0-9]+\.min\.en\.json(?:\.br)? https://kailous.github.io/figma-zh-CN-localized/lang/zh.json 307

[MITM]
skip-server-cert-verify = true
h2 = true
hostname = %APPEND% *.figma.*
