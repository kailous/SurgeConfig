#!name=自定义分流规则
#!desc=按用途分类的常用服务分流规则，包含设计创作、流媒体、AI 服务、设计灵感和小红书推送。
#!author=kailous
#!homepage=https://github.com/kailous/SurgeConfig

[Rule]
# 设计创作 / Adobe
DOMAIN-SUFFIX,cc-api-data.adobe.io,Adobe
DOMAIN-SUFFIX,adobesc.com,Adobe
DOMAIN-SUFFIX,adobe.com,Adobe

# 设计创作 / Figma
DOMAIN-SUFFIX,s3-alpha-sig.figma.com,Figma
DOMAIN-SUFFIX,www.figma.com,Figma
DOMAIN-SUFFIX,static.figma.com,Figma

# 设计社区 / Behance
DOMAIN-SUFFIX,behance.com,Behance
DOMAIN-SUFFIX,a5.behance.net,Behance
DOMAIN-SUFFIX,www.behance.net,Behance
DOMAIN-SUFFIX,mir-cdn-cf.behance.net,Behance
DOMAIN-SUFFIX,mir-s3-cdn-cf.behance.net,Behance

# 设计灵感 / awwwards
DOMAIN-SUFFIX,awwwards.com,awwwards
DOMAIN-SUFFIX,assets.awwwards.com,awwwards
DOMAIN-KEYWORD,awwwards,awwwards

# AI 服务 / Grok
DOMAIN-SUFFIX,grok.com,🤖Grok
DOMAIN-SUFFIX,api.x.ai,🤖Grok
DOMAIN-SUFFIX,x.com,🤖Grok

# AI 服务 / Claude
DOMAIN-SUFFIX,anthropic.com,Claude
DOMAIN-SUFFIX,claude.ai,Claude
DOMAIN-SUFFIX,statsig.com,Claude
DOMAIN-SUFFIX,featuregates.org,Claude
DOMAIN-SUFFIX,api.github.com,Claude
DOMAIN-SUFFIX,raw.githubusercontent.com,Claude

# 流媒体 / Spotify
DOMAIN-SUFFIX,i.scdn.co,Spotify
DOMAIN-SUFFIX,p.scdn.co,Spotify
DOMAIN-SUFFIX,r.scdn.co,Spotify
DOMAIN-SUFFIX,t.scdn.co,Spotify
DOMAIN-SUFFIX,u.scdn.co,Spotify
DOMAIN-SUFFIX,audio-ec.spotify.com,Spotify
DOMAIN-SUFFIX,ap-gae2.spotify.com,Spotify
DOMAIN-SUFFIX,gae2-dealer2.spotify.com,Spotify
DOMAIN-SUFFIX,spotify.com,Spotify

# 社交推送 / 小红书
DOMAIN,apppush-overseas.xiaohongshu.com,小红书
DOMAIN,apppush.xiaohongshu.com,小红书
DOMAIN,apppush-hz.xiaohongshu.com,小红书
DOMAIN,apppush-sh5.xiaohongshu.com,小红书
DOMAIN,apppush-rts.xiaohongshu.com,小红书
DOMAIN,dc.xiaohongshu.com,小红书
DOMAIN,ark.xiaohongshu.com,小红书
